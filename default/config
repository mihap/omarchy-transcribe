# shellcheck shell=bash disable=SC2034
# omarchy-transcribe configuration
#
# This file is sourced as shell by omarchy-transcribe. These are the shipped
# defaults, read from the plugin checkout; do not edit them here. Put
# overrides in ~/.config/omarchy-transcribe/config (same keys, only what you
# change).

# Extra directories to scan for ggml-*.bin whisper models, colon-separated.
# ~/.local/share/omarchy-transcribe/models is always scanned first and is the
# only directory `omarchy plugin remove` deletes. Directories listed here
# are never deleted.
MODEL_DIRS="$HOME/.local/share/whisper"

# Model listed first in the picker when nothing has been used yet, and the
# model downloaded on first run / by the plugin's first-time setup.
DEFAULT_MODEL="small"

# Spoken language passed to whisper-cli (-l). "auto" detects it.
LANGUAGE="auto"

# Threads for whisper-cli (-t). Empty uses whisper-cli's own default.
THREADS="$(nproc)"

# Any extra whisper-cli flags, split on whitespace (no glob expansion),
# e.g. "--beam-size 5".
WHISPER_ARGS=""
