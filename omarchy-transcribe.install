post_install() {
  cat <<'EOF'
==> Finish setting up Transcribe for your user (downloads the whisper model,
==> adds the Omarchy menu entry, and reloads Nautilus):
==>
==>   omarchy-transcribe-install
EOF
}

post_upgrade() {
  # Nautilus loads python extensions at startup; users pick up changes on
  # their next Files window after quitting it (omarchy-transcribe-install does
  # that too).
  :
}

pre_remove() {
  cat <<'EOF'
==> Per-user files (downloaded models, config, menu entry) are not touched by
==> pacman. Remove them with omarchy-transcribe-remove, which also runs this
==> package removal.
EOF
}
