#!/bin/bash

# omarchy:summary=Set up Transcribe: download the default whisper model and add the menu entry
# omarchy:args=[--yes]
# omarchy:examples=omarchy-transcribe-install|omarchy-transcribe-install --yes

# Per-user setup for the omarchy-transcribe package. The package itself only
# touches system paths; everything under $HOME (the model download, the
# Omarchy menu row) is done here so pacman never writes into a home directory.

set -euo pipefail
shopt -s inherit_errexit

# gum's colors come from the environment, which was captured at login; export
# the current theme's values so the prompts below follow a theme switched
# since then. Same thing Omarchy's floating-terminal wrapper does.
# shellcheck source=/dev/null
source omarchy-restart-gum

assume_yes=false
[[ ${1:-} == "--yes" || ${1:-} == "-y" ]] && assume_yes=true

if ! omarchy-cmd-present omarchy-transcribe whisper-cli; then
  echo "omarchy-transcribe or whisper-cli is not installed. Install the package first:" >&2
  echo "  makepkg -si   (from the omarchy-transcribe repo)" >&2
  exit 1
fi

# The effective config (shipped defaults + user overrides) comes from the
# command itself, so there is one loader.
eval "$(omarchy-transcribe --print-config)"

# Without a terminal to ask in (a hook, a non-interactive shell) an optional
# step is skipped rather than assumed, unless --yes was passed.
confirm() {
  [[ $assume_yes == true ]] && return 0
  [[ -t 0 && -t 2 ]] || return 1
  gum confirm "$1"
}

# ------------------------------------------------------------------ model

if [[ -n $(omarchy-transcribe --list-models) ]]; then
  echo "Whisper models already available:"
  omarchy-transcribe --list-models | sed 's/^/  /'
else
  if confirm "Download the whisper '$DEFAULT_MODEL' model (~500MB) to enable transcription?"; then
    omarchy-transcribe --download "$DEFAULT_MODEL"
  else
    echo "Skipped. Download later with: omarchy-transcribe --download $DEFAULT_MODEL"
  fi
fi

# ------------------------------------------------------------------ GPU

# whisper-cli goes through libggml, which loads backends from /usr/lib/ggml at
# runtime, so the Vulkan backend is a separate optional package.
if omarchy-hw-vulkan && ! pacman -Q ggml-vulkan &>/dev/null; then
  if confirm "Vulkan detected. Install ggml-vulkan for GPU-accelerated transcription?"; then
    omarchy-pkg-add ggml-vulkan || echo "ggml-vulkan install failed; CPU transcription still works." >&2
  fi
fi

# ------------------------------------------------------------------ menu row

menu_file="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
marker="  // omarchy-transcribe (managed by omarchy-transcribe-install)"
# Same wrapper the Nautilus entry uses: a floating terminal shows whisper's
# progress on long files and keeps errors visible.
row='  "trigger.transcribe": {"icon":"󰨖","label":"Transcribe","when":"omarchy-cmd-present omarchy-transcribe","action":"omarchy-launch-floating-terminal-with-presentation omarchy-transcribe"},'

if [[ ! -f $menu_file ]]; then
  mkdir -p "$(dirname "$menu_file")"
  cp "${OMARCHY_PATH:-/usr/share/omarchy}/config/omarchy/extensions/omarchy-menu.jsonc" "$menu_file"
fi

if grep -qF '"trigger.transcribe"' "$menu_file"; then
  echo "Menu entry already present in $menu_file"
else
  # Insert before the last line that closes the top-level object. The file
  # is JSONC and the shell tolerates trailing commas, so appending a row that
  # ends in a comma is safe regardless of what precedes it.
  mapfile -t lines <"$menu_file"
  last=-1
  for (( i=${#lines[@]}-1; i>=0; i-- )); do
    if [[ ${lines[$i]} =~ ^[[:space:]]*\}[[:space:]]*$ ]]; then
      last=$i
      break
    fi
  done

  if (( last < 0 )); then
    echo "Could not find the closing brace in $menu_file; add this row yourself:" >&2
    echo "$row" >&2
  else
    {
      printf '%s\n' "${lines[@]:0:$last}"
      printf '%s\n' "$marker" "$row"
      printf '%s\n' "${lines[@]:$last}"
    } >"$menu_file.tmp"
    mv -f "$menu_file.tmp" "$menu_file"
    echo "Added Transcribe to the Omarchy menu ($menu_file)"
  fi
fi

# ------------------------------------------------------------------ nautilus

# Nautilus loads python extensions at startup only. Quitting it would close
# every open Files window, so that is left to the user.
if pgrep -x nautilus >/dev/null; then
  echo ""
  echo "Files (Nautilus) is running. The right-click Transcribe entry appears"
  echo "once it is restarted: run 'nautilus -q' (closes open Files windows)"
  echo "or wait for your next login."
fi

omarchy-notification-send -g 󰨖 "Transcribe Ready" "Right-click a video in Files, or open the Omarchy menu." -t 10000
