#!/bin/bash

# omarchy:group=transcribe
# omarchy:summary=Transcribe a video or audio file to SRT subtitles with whisper.cpp
# omarchy:args=[--path path] [--download <model>] [--list-models] [--list-available] [--pick-model] [--print-config] [input] [model] [language]
# omarchy:examples=omarchy-transcribe|omarchy-transcribe --path ~/Videos|omarchy-transcribe ~/Videos/talk.mp4|omarchy-transcribe ~/Videos/talk.mp4 small en|omarchy-transcribe --download small

set -euo pipefail
# errexit is off inside $(...) by default, which would let a failed
# whisper-cli inside output=$(transcribe ...) go unnoticed.
shopt -s inherit_errexit

# ------------------------------------------------------------------ defaults
#
# Overridable from default/config in the plugin checkout (shipped) and then
# ~/.config/omarchy-transcribe/config (user). Both are plain sourced shell.

MODEL_DIRS="$HOME/.local/share/whisper"
DEFAULT_MODEL="small"
LANGUAGE="auto"
THREADS="$(nproc)"
WHISPER_ARGS=""

# ~/.local/bin/omarchy-transcribe is a symlink into the checkout; resolve it
# so the shipped defaults are found next to the real file.
PLUGIN_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
SHIPPED_CONFIG="$PLUGIN_DIR/default/config"
USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-transcribe/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-transcribe"
OWNED_MODEL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-transcribe/models"
MODEL_BASE_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main"

ICON="󰨖"
INPUT_FORMATS="mp4 mov m4v mkv webm avi mp3 m4a wav flac ogg opus aac wma"
MODEL_NAME_PATTERN='^[A-Za-z0-9._-]+$'
DOWNLOAD_ROW="Download another model…"

# Well-known ggml models on huggingface.co/ggerganov/whisper.cpp, with
# download sizes. Any other name that exists there works with --download too.
# "name<TAB>size<TAB>note"
AVAILABLE_MODELS=(
  $'tiny\t75M\tfastest, rough'
  $'tiny.en\t75M\tEnglish only'
  $'base\t142M\t'
  $'base.en\t142M\tEnglish only'
  $'small\t466M\tdefault, good balance'
  $'small.en\t466M\tEnglish only'
  $'small-q5_1\t182M\tsmall, quantized'
  $'medium\t1.5G\tbetter accuracy, slower'
  $'medium.en\t1.5G\tEnglish only'
  $'medium-q5_0\t515M\tmedium, quantized'
  $'large-v3-turbo\t1.5G\tnear large-v3 accuracy, much faster'
  $'large-v3-turbo-q5_0\t548M\tturbo, quantized'
  $'large-v3\t2.9G\tbest accuracy, slowest'
  $'large-v3-q5_0\t1.1G\tlarge-v3, quantized'
)

# shellcheck disable=SC1090
[[ -r $SHIPPED_CONFIG ]] && source "$SHIPPED_CONFIG"
# shellcheck disable=SC1090
[[ -r $USER_CONFIG ]] && source "$USER_CONFIG"

usage() {
  cat <<'EOF'
Usage:
  omarchy-transcribe [--path path] [input] [model] [language]
  omarchy-transcribe --download <model>
  omarchy-transcribe --list-models | --pick-model | --print-config

With no input, pick a video or audio file from ~/Videos and ~/Music, or only
from --path when provided. Then pick one of the locally available whisper
models. The transcript is written as SRT next to the input, with the same
name, overwriting any previous one.

Options:
  --path path       Limit interactive fuzzy file selection to this path
  --download model  Download a ggml model (e.g. small, medium, large-v3-turbo)
                    into ~/.local/share/omarchy-transcribe/models and exit
  --list-models     Print locally available models as "name<TAB>path" and exit
  --list-available  Print well-known downloadable models with sizes and exit
  --pick-model      Show the model picker, print the chosen name, and exit
                    (lets a caller ask once for several files)
  --print-config    Print the effective configuration as KEY=value and exit

Models are looked up in ~/.local/share/omarchy-transcribe/models and in every
directory listed in MODEL_DIRS (default: ~/.local/share/whisper). A model
named "small" is the file ggml-small.bin. The picker's last row downloads
another model; so does --download, or dropping a ggml-*.bin into a model dir.

Config: ~/.config/omarchy-transcribe/config
EOF
}

# Errors reach the user even when there is no terminal, as when launched from
# the Omarchy menu: stderr for the shell, a notification for the desktop.
fail() {
  echo "$1" >&2
  if [[ ! -t 2 ]]; then
    omarchy-notification-send -u critical -g "$ICON" "Transcribe failed" "$1" || true
  fi
  return 1
}

# ------------------------------------------------------------------ models

model_dirs() {
  local dir
  local -a extra
  printf '%s\n' "$OWNED_MODEL_DIR"
  IFS=: read -r -a extra <<<"$MODEL_DIRS"
  for dir in "${extra[@]}"; do
    [[ -n $dir ]] && printf '%s\n' "${dir/#\~/$HOME}"
  done
}

# ggml-small.bin -> small
model_name_from_file() {
  local name
  name=$(basename -- "$1")
  name="${name#ggml-}"
  printf '%s\n' "${name%.bin}"
}

# Prints "name<TAB>path" per model, first directory wins on duplicate names.
list_models() {
  local dir file name
  declare -A seen=()

  while IFS= read -r dir; do
    [[ -d $dir ]] || continue
    for file in "$dir"/ggml-*.bin; do
      [[ -f $file ]] || continue
      name=$(model_name_from_file "$file")
      [[ -n ${seen[$name]:-} ]] && continue
      seen[$name]=1
      printf '%s\t%s\n' "$name" "$file"
    done
  done < <(model_dirs)
}

model_path() {
  local wanted="$1" name path

  if [[ -f $wanted ]]; then
    printf '%s\n' "$wanted"
    return 0
  fi

  while IFS=$'\t' read -r name path; do
    if [[ $name == "$wanted" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done < <(list_models)

  return 1
}

human_size() {
  du -h -- "$1" | cut -f1
}

last_model() {
  [[ -r $STATE_DIR/last-model ]] && cat "$STATE_DIR/last-model" || true
}

remember_model() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" >"$STATE_DIR/last-model"
}

# Prints "name<TAB>size<TAB>note" for each well-known model, plus "installed"
# in a fourth column when it is already present locally.
list_available() {
  local entry name size note
  declare -A have=()

  while IFS=$'\t' read -r name _; do
    have[$name]=1
  done < <(list_models)

  for entry in "${AVAILABLE_MODELS[@]}"; do
    IFS=$'\t' read -r name size note <<<"$entry"
    printf '%s\t%s\t%s\t%s\n' "$name" "$size" "$note" "${have[$name]:+installed}"
  done
}

# Second picker: well-known models not yet present. Downloads the choice and
# prints its name; download_model talks on stderr, so a caller capturing
# stdout only gets the name.
select_and_download_model() {
  local entry name size note choice
  local options=()
  declare -A have=()

  while IFS=$'\t' read -r name _; do
    have[$name]=1
  done < <(list_models)

  # Split each entry here rather than re-reading list_available's output: an
  # empty note column would collapse under a tab IFS and shift the columns.
  for entry in "${AVAILABLE_MODELS[@]}"; do
    IFS=$'\t' read -r name size note <<<"$entry"
    [[ -n ${have[$name]:-} ]] && continue
    options+=("$ICON"$'\t'"$name"$'\t'"$size${note:+ · $note}")
  done

  (( ${#options[@]} > 0 )) || { echo "Every well-known model is already installed." >&2; return 1; }

  choice=$(omarchy-menu-select "Download model" "${options[@]}" -- --width 520 | cut -f1)
  [[ -n $choice ]] || return 1

  download_model "$choice"
  printf '%s\n' "$choice"
}

# Shows the picker with the last-used (or DEFAULT_MODEL) first, so Enter
# repeats the previous choice. The last row downloads another model.
select_model() {
  local preferred name path size choice
  local options=() rest=()

  preferred=$(last_model)
  [[ -n $preferred ]] || preferred="$DEFAULT_MODEL"

  while IFS=$'\t' read -r name path; do
    size=$(human_size "$path")
    if [[ $name == "$preferred" ]]; then
      options+=("$ICON"$'\t'"$name"$'\t'"$size")
    else
      rest+=("$ICON"$'\t'"$name"$'\t'"$size")
    fi
  done < <(list_models)

  options+=("${rest[@]}")
  options+=("󰇚"$'\t'"$DOWNLOAD_ROW"$'\t'"medium, large-v3-turbo, …")

  # With a subtext the menu returns "<label><TAB><subtext>"; keep the label.
  choice=$(omarchy-menu-select "Select model" "${options[@]}" -- --width 400 | cut -f1)
  [[ -n $choice ]] || return 1

  if [[ $choice == "$DOWNLOAD_ROW" ]]; then
    select_and_download_model
  else
    printf '%s\n' "$choice"
  fi
}

# All chatter on stderr: --pick-model and the picker's download row run
# inside $(...) in callers that expect nothing but a model name on stdout.
download_model() {
  local name="$1" url target tmp

  name="${name#ggml-}"
  name="${name%.bin}"
  if [[ ! $name =~ $MODEL_NAME_PATTERN ]]; then
    fail "Invalid model name: '$1' (letters, digits, dot, dash, underscore only)"
    return
  fi

  url="$MODEL_BASE_URL/ggml-$name.bin"
  target="$OWNED_MODEL_DIR/ggml-$name.bin"
  tmp="$target.part"

  if [[ -f $target ]]; then
    echo "Model '$name' already present at $target" >&2
    return 0
  fi

  mkdir -p "$OWNED_MODEL_DIR"
  echo "Downloading whisper model '$name'..." >&2
  echo "  $url" >&2
  if ! curl -fL --progress-bar -C - -o "$tmp" "$url"; then
    rm -f "$tmp"
    fail "Download failed for model '$name'"
    return
  fi
  mv -f "$tmp" "$target"
  echo "Saved to $target ($(human_size "$target"))" >&2
}

# First run with no model anywhere: fetch the default one rather than ask.
ensure_any_model() {
  if [[ -n $(list_models) ]]; then
    return 0
  fi

  echo "No whisper models found, downloading '$DEFAULT_MODEL'..." >&2
  omarchy-notification-send -g "$ICON" "Downloading whisper model" "$DEFAULT_MODEL, this happens once" || true
  download_model "$DEFAULT_MODEL"
}

print_config() {
  local key
  for key in MODEL_DIRS DEFAULT_MODEL LANGUAGE THREADS WHISPER_ARGS OWNED_MODEL_DIR STATE_DIR USER_CONFIG; do
    printf '%s=%q\n' "$key" "${!key}"
  done
}

# ------------------------------------------------------------------ input

media_type() {
  local mime
  # -L: a symlink to a video is a video.
  mime=$(file -bL --mime-type -- "$1")

  case "$mime" in
  video/* | audio/*) return 0 ;;
  *) fail "Unsupported file type: $mime" ;;
  esac
}

output_stem() {
  local input="$1" dir base
  dir=$(dirname -- "$input")
  base=$(basename -- "$input")
  printf '%s/%s' "$dir" "${base%.*}"
}

transcribe() {
  local input="$1" model="$2" language="$3" stem partial rc
  local -a args extra_args

  stem=$(output_stem "$input")
  # whisper-cli appends .srt to -of, so this lands as <stem>.partial.srt and
  # moves into place only on success: a failed run can neither be masked by
  # the previous transcript nor destroy it.
  partial="$stem.partial"

  args=(-m "$model" -f "$input" -l "$language" -osrt -of "$partial" --print-progress)
  [[ -n $THREADS ]] && args+=(-t "$THREADS")
  # Word-split only, no glob expansion.
  read -r -a extra_args <<<"$WHISPER_ARGS"
  args+=("${extra_args[@]}")

  rm -f -- "$partial.srt"
  whisper-cli "${args[@]}" || rc=$?
  if (( ${rc:-0} != 0 )) || [[ ! -f $partial.srt ]]; then
    rm -f -- "$partial.srt"
    (( ${rc:-0} != 0 )) || echo "whisper-cli produced no $partial.srt" >&2
    return "${rc:-1}"
  fi

  mv -f -- "$partial.srt" "$stem.srt"
  printf '%s.srt\n' "$stem"
}

# ------------------------------------------------------------------ main

main() {
  local input="" model="" language="" search_path="" download=""
  local mode="transcribe"
  local positional=() model_file output model_name

  while (( $# > 0 )); do
    case "$1" in
    --path)
      shift
      (( $# > 0 )) || { echo "Missing value for --path" >&2; return 2; }
      search_path="$1"
      ;;
    --download)
      shift
      (( $# > 0 )) || { echo "Missing value for --download" >&2; return 2; }
      download="$1"
      mode="download"
      ;;
    --list-models) mode="list" ;;
    --list-available) mode="available" ;;
    --pick-model) mode="pick" ;;
    --print-config) mode="config" ;;
    --help | -h)
      usage
      return 0
      ;;
    --)
      shift
      positional+=("$@")
      break
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage >&2
      return 2
      ;;
    *)
      positional+=("$1")
      ;;
    esac
    shift
  done

  case "$mode" in
  config)
    print_config
    return
    ;;
  list)
    list_models
    return
    ;;
  available)
    list_available | column -t -s $'\t' -N MODEL,SIZE,NOTE,STATUS 2>/dev/null || list_available
    return
    ;;
  download)
    download_model "$download"
    return
    ;;
  pick)
    ensure_any_model
    model=$(select_model)
    [[ -n $model ]] || return 1
    remember_model "$model"
    printf '%s\n' "$model"
    return
    ;;
  esac

  if ! omarchy-cmd-present whisper-cli; then
    fail "whisper-cli not found. Install whisper-cpp: omarchy-pkg-add whisper-cpp"
  fi

  input="${positional[0]:-}"
  model="${positional[1]:-}"
  language="${positional[2]:-$LANGUAGE}"

  if [[ -z $search_path ]]; then
    local dir
    for dir in "$HOME/Videos" "$HOME/Music"; do
      [[ -d $dir ]] && search_path="${search_path:+$search_path:}$dir"
    done
    [[ -n $search_path ]] || search_path="$HOME"
  fi

  if [[ -z $input ]]; then
    input=$(omarchy-menu-file "Transcribe video or audio" "$search_path" "$INPUT_FORMATS")
  fi

  [[ -n $input ]] || return 1
  [[ -f $input ]] || fail "File not found: $input"
  media_type "$input"

  ensure_any_model

  if [[ -z $model ]]; then
    model=$(select_model)
  fi
  [[ -n $model ]] || return 1

  if ! model_file=$(model_path "$model"); then
    fail "Model not found: $model (run: omarchy-transcribe --download $model)"
  fi
  # Remember the name, not whatever was typed, so a path argument still
  # preselects its model in the picker next time.
  model_name=$(model_name_from_file "$model_file")
  remember_model "$model_name"

  omarchy-notification-send -g "$ICON" "Transcribing…" "$(basename -- "$input") with $model_name"
  if ! output=$(transcribe "$input" "$model_file" "$language"); then
    fail "whisper-cli failed on $(basename -- "$input") with $model_name"
  fi
  omarchy-notification-send -g "$ICON" "Transcribed with $model_name" "Saved $(basename -- "$output")"
}

main "$@"
