#!/bin/bash

# Plugin enable hook. Run by plugin/Service.qml whenever the shell loads the
# service: on `omarchy plugin enable`, and on every shell start while the
# plugin is enabled. Must therefore be quiet and idempotent.
#
# Usage: plugin/enable [plugin-dir]   (defaults to this script's parent)
#
# Wires the checkout into the user's home:
#   ~/.local/bin/omarchy-transcribe                -> bin/omarchy-transcribe
#   ~/.local/share/nautilus-python/extensions/...  -> nautilus/ (symlink)
#   Transcribe row in the Omarchy menu
# keeps a copy of plugin/disable outside the checkout (see Service.qml), and,
# the first time only, opens a floating terminal running plugin/setup, which
# installs whisper-cpp (sudo), the GPU backend, and the default model.

set -euo pipefail

PLUGIN_DIR="${1:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
BIN_DIR="$HOME/.local/bin"
EXT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/nautilus-python/extensions"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-transcribe"
SETUP_MARKER="$STATE_DIR/setup-done"
LOG="$STATE_DIR/plugin.log"

mkdir -p "$STATE_DIR"
exec >>"$LOG" 2>&1
echo "[$(date -Is)] enable: $PLUGIN_DIR"

# The disable hook must survive `omarchy plugin remove` deleting the checkout.
install -m 755 "$PLUGIN_DIR/plugin/disable" "$STATE_DIR/plugin-disable"

mkdir -p "$BIN_DIR" "$EXT_DIR"
ln -sfn "$PLUGIN_DIR/bin/omarchy-transcribe" "$BIN_DIR/omarchy-transcribe"
ln -sfn "$PLUGIN_DIR/nautilus/omarchy-transcribe.py" "$EXT_DIR/omarchy-transcribe.py"

# Older versions linked the helpers too; they run by path now.
for f in omarchy-transcribe-install omarchy-transcribe-remove omarchy-transcribe-menu; do
  link="$BIN_DIR/$f"
  [[ -L $link && $(readlink -- "$link") == "$PLUGIN_DIR/"* ]] && rm -f "$link"
done

PATH="$BIN_DIR:$PATH"

if [[ ! -f $SETUP_MARKER ]] || ! omarchy-cmd-present whisper-cli; then
  # First time (or whisper-cpp got removed): package installs need sudo and
  # the model download deserves a progress bar, so do it where the user can
  # see it. plugin/setup writes the marker when it is done.
  #
  # The shell creates the service twice in quick succession on `plugin add
  # --enable` (rescan, then enable), so claim a pending marker atomically
  # first; plugin/setup clears it on exit. A stale one from a crashed setup
  # is ignored after 15 minutes.
  pending="$STATE_DIR/setup.pending"
  if [[ -d $pending ]] && [[ -n $(find "$pending" -maxdepth 0 -mmin +15) ]]; then
    rmdir "$pending" 2>/dev/null || true
  fi
  if ! mkdir "$pending" 2>/dev/null; then
    echo "first-time setup already running, not opening a second terminal"
    exit 0
  fi
  echo "first-time setup in a floating terminal"
  # The terminal inherits our fds; keep its own chatter out of this log.
  omarchy-launch-floating-terminal-with-presentation "bash $(printf '%q' "$PLUGIN_DIR/plugin/setup")" >/dev/null 2>&1
  exit 0
fi

"$PLUGIN_DIR/bin/omarchy-transcribe-menu" add
echo "enabled quietly"
