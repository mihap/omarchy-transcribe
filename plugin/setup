#!/bin/bash

# First-time plugin setup, shown in a floating terminal by plugin/enable.
# Everything that needs sudo or deserves a progress bar happens here:
# whisper-cpp, the GPU backend, the default model, the menu row. It records
# which packages it installed so `omarchy plugin remove` can take exactly
# those back out, then writes the setup-done marker. No prompts: the defaults
# are the choice. Safe to re-run.

set -euo pipefail
shopt -s inherit_errexit

# Opened by plugin/enable with a cleared environment; pin the same PATH here
# so the terminal cannot widen it, and take the Omarchy helpers (one of
# which runs sudo pacman) by absolute path. A missing helper fails its own
# call under set -e; the notification is best-effort.
export PATH=/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin
OMARCHY_BIN=/usr/share/omarchy/bin
PKG_ADD="$OMARCHY_BIN/omarchy-pkg-add"
HW_VULKAN="$OMARCHY_BIN/omarchy-hw-vulkan"
NOTIFY="$OMARCHY_BIN/omarchy-notification-send"

PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-transcribe"
TRANSCRIBE="$PLUGIN_DIR/bin/omarchy-transcribe"
MENU="$PLUGIN_DIR/bin/omarchy-transcribe-menu"
ICON="󰨖"

mkdir -p "$STATE_DIR"

# The pending marker is claimed by plugin/enable so a second enable does not
# open a second setup. Without the done marker, enable tries again at the
# next shell start; say so when that is going to happen.
finish() {
  local rc=$?
  rmdir "$STATE_DIR/setup.pending" 2>/dev/null || true
  if (( rc != 0 )); then
    echo "" >&2
    echo "Setup did not finish (exit $rc). It runs again at the next shell start;" >&2
    echo "to stop that, disable the plugin: omarchy plugin disable mihap.transcribe" >&2
  fi
}
trap finish EXIT

# Remember what we install, so removing the plugin can take exactly that
# with it and leave a whisper-cpp the user already had alone.
record_installed() {
  echo "$1" >>"$STATE_DIR/installed-packages"
}

echo "Setting up Transcribe (plugin at $PLUGIN_DIR)"
echo ""

# ------------------------------------------------------------------ whisper

if /usr/bin/pacman -Q whisper-cpp &>/dev/null; then
  echo "whisper-cpp already installed"
else
  "$PKG_ADD" whisper-cpp
  record_installed whisper-cpp
fi

# ------------------------------------------------------------------ model

# The effective config (shipped defaults + user overrides) comes from the
# command itself, so there is one loader. Only the model name is needed here,
# and it is read as a value, not evaluated: the user's config is sourced by
# the command in its own process, never by this one, which goes on to sudo.
# --download rejects anything outside the committed model table anyway.
DEFAULT_MODEL=$("$TRANSCRIBE" --print-config | sed -n 's/^DEFAULT_MODEL=//p' | head -n 1)
if [[ ! $DEFAULT_MODEL =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "DEFAULT_MODEL in the config is not a model name: '$DEFAULT_MODEL'" >&2
  exit 1
fi

if [[ -n $("$TRANSCRIBE" --list-models) ]]; then
  echo "Whisper models already available:"
  "$TRANSCRIBE" --list-models | sed 's/^/  /'
else
  "$TRANSCRIBE" --download "$DEFAULT_MODEL"
fi

# ------------------------------------------------------------------ GPU

# whisper-cli goes through libggml, which loads backends from /usr/lib/ggml at
# runtime, so the Vulkan backend is a separate package. Install it wherever a
# Vulkan driver is present; CPU transcription keeps working if this fails.
if "$HW_VULKAN"; then
  if /usr/bin/pacman -Q ggml-vulkan &>/dev/null; then
    echo "GPU acceleration: ggml-vulkan already installed"
  else
    echo "Vulkan detected, installing ggml-vulkan for GPU-accelerated transcription..."
    if "$PKG_ADD" ggml-vulkan; then
      record_installed ggml-vulkan
    else
      echo "ggml-vulkan install failed; CPU transcription still works." >&2
    fi
  fi
fi

# ------------------------------------------------------------------ menu row

"$MENU" add

touch "$STATE_DIR/setup-done"

# ------------------------------------------------------------------ nautilus

# Nautilus loads python extensions at startup only, and closing its windows
# does not quit it: it stays up as a background service, so Ctrl-Q changes
# nothing. Only `nautilus -q` does, at the cost of open Files windows.
if pgrep -x nautilus >/dev/null; then
  echo ""
  echo "Restarting Files (closes open Files windows) so the right-click entry appears."
  nautilus -q || true
fi

echo ""
echo "Disable (keeps models) or remove (deletes everything it installed) from"
echo "Omarchy menu > Setup > Plugins."
"$NOTIFY" -g "$ICON" "Transcribe Ready" "Right-click a video in Files, or open the Omarchy menu." -t 10000 || true
