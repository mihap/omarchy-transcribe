#!/bin/bash

# Plugin disable hook. Run when the shell destroys the service, which happens
# on `omarchy plugin disable`, on `omarchy plugin remove`, and when the shell
# itself restarts (keepLoaded in the manifest keeps it out of plugin rescans).
#
# Usage: plugin/disable [plugin-dir]        (hook mode, run by Service.qml)
#        plugin/disable --purge             (in a floating terminal, see below)
#
#   restart  shell.json still lists the plugin -> touch nothing
#   disable  checkout still there            -> unlink, drop the menu row;
#                                               models and packages stay
#   remove   checkout gone                   -> the above, then a floating
#                                               terminal purges models, config,
#                                               state, and the packages that
#                                               setup installed (sudo)
#
# Removing a plugin that is already disabled destroys no service, so no hook
# runs and nothing is purged. The copy under ~/.local/state is kept on disable
# for exactly that case: `bash ~/.local/state/omarchy-transcribe/plugin-disable
# --purge` does by hand what remove-while-enabled does on its own.
#
# Self-contained on purpose: on remove the checkout is already gone when this
# runs (Service.qml runs the copy plugin/enable stored under ~/.local/state),
# so nothing here may read a file from the checkout. The plugin dir is only
# used as a string, to recognise the links that point into it.

set -euo pipefail

# Runs automatically (and the purge in a terminal it opens itself), so
# nothing here may resolve through a user-writable place: fixed PATH of
# root-owned dirs, Omarchy helpers by absolute path. Service.qml already
# cleared the environment; this holds when the copy is run by hand too.
# Notifications are best-effort, everything else fails at its own call.
export PATH=/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin
OMARCHY_BIN=/usr/share/omarchy/bin
PKG_DROP="$OMARCHY_BIN/omarchy-pkg-drop"
NOTIFY="$OMARCHY_BIN/omarchy-notification-send"

# Floating terminal for the purge. Same launch as plugin/enable, and for the
# same reason: omarchy-launch-floating-terminal-with-presentation goes
# through the uwsm app daemon, whose environment is the session's, not ours.
open_terminal() {
  local inner
  inner="export PATH=$PATH; $OMARCHY_BIN/omarchy-show-logo; /usr/bin/bash $(printf '%q' "$1") ${2:-}; if (( \$? != 130 )); then $OMARCHY_BIN/omarchy-show-done; fi"
  /usr/bin/setsid -f /usr/bin/systemd-run --user --scope --quiet --collect --slice=app-graphical.slice -- \
    /usr/bin/xdg-terminal-exec --app-id=org.omarchy.terminal --title=Omarchy \
    -e /usr/bin/bash -c "$inner" >/dev/null 2>&1
}

PLUGIN_ID="mihap.transcribe"
BIN_DIR="$HOME/.local/bin"
EXT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/nautilus-python/extensions"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-transcribe"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-transcribe"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-transcribe"
SHELL_JSON="$HOME/.config/omarchy/shell.json"
MENU_FILE="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
LOG="$STATE_DIR/plugin.log"
ICON="󰨖"

# ------------------------------------------------------------------ purge

# Everything the plugin brought onto the machine. Runs in a floating terminal
# because dropping packages needs sudo. Packages first: they are the step
# that can fail (cancelled password), and a cancelled sudo must not leave
# the user with nothing to retry.
purge() {
  local pkgs=() left=()

  echo "Transcribe plugin removed."
  echo ""

  if [[ -r $STATE_DIR/installed-packages ]]; then
    mapfile -t pkgs < <(grep -v '^\s*$' "$STATE_DIR/installed-packages" | sort -u)
  fi

  if (( ${#pkgs[@]} > 0 )); then
    echo "Cleaning up unused dependencies..."
    if ! "$PKG_DROP" "${pkgs[@]}"; then
      left+=("${pkgs[*]} still installed (cancelled or failed; run: sudo pacman -Rns ${pkgs[*]})")
    fi
    echo ""
  fi

  echo "Deleting downloaded models and settings:"
  for d in "$DATA_DIR" "$CONFIG_DIR" "$STATE_DIR"; do
    [[ -e $d ]] && echo "  $(du -sh -- "$d" 2>/dev/null | cut -f1)  $d"
  done
  rm -rf -- "$DATA_DIR" "$CONFIG_DIR" "$STATE_DIR"

  # Nautilus keeps the extension module loaded until it is restarted, and
  # closing its windows does not quit it. Same as the setup: just do it.
  if pgrep -x nautilus >/dev/null; then
    echo ""
    echo "Restarting Files (closes open Files windows) to unload the right-click entry."
    nautilus -q || true
  fi

  echo ""
  if (( ${#left[@]} > 0 )); then
    echo "Cleanup finished with leftovers: ${left[*]}"
    "$NOTIFY" -u critical -g "$ICON" "Transcribe removed, cleanup incomplete" "${left[*]}" || true
  else
    echo "Cleanup finished."
    "$NOTIFY" -g "$ICON" "Transcribe removed" "Models, settings and added packages cleaned up." -t 8000 || true
  fi
}

if [[ ${1:-} == "--purge" ]]; then
  purge
  exit 0
fi

# ------------------------------------------------------------------ hook

PLUGIN_DIR="${1:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd || echo /nonexistent)}"

mkdir -p "$STATE_DIR"
exec >>"$LOG" 2>&1
echo "[$(date -Is)] disable: $PLUGIN_DIR"

still_enabled() {
  [[ -f $SHELL_JSON ]] && jq -e --arg id "$PLUGIN_ID" \
    '(.plugins // []) | any(.[]; (.id // .) == $id)' "$SHELL_JSON" >/dev/null 2>&1
}

# The shell destroys the service before it has finished writing shell.json,
# so a single look races the write and mistakes a real disable for a restart.
# Give the file a few seconds to change; a restart never changes it.
for (( i = 0; i < 40; i++ )); do
  still_enabled || break
  sleep 0.1
done
if still_enabled; then
  echo "still enabled in shell.json after 4s: shell restart, leaving everything in place"
  exit 0
fi

# Only remove links that point into the checkout (dangling or not); a
# hand-made link is not ours. Older versions linked the helpers too.
for f in omarchy-transcribe omarchy-transcribe-install omarchy-transcribe-remove omarchy-transcribe-menu; do
  link="$BIN_DIR/$f"
  [[ -L $link && $(readlink -- "$link") == "$PLUGIN_DIR/"* ]] && rm -f "$link"
done
ext="$EXT_DIR/omarchy-transcribe.py"
[[ -L $ext && $(readlink -- "$ext") == "$PLUGIN_DIR/"* ]] && rm -f "$ext"

# Menu row: same marker-guarded removal as bin/omarchy-transcribe-menu,
# inlined because that file may no longer exist.
if [[ -f $MENU_FILE ]] && grep -qF '// omarchy-transcribe (managed by' "$MENU_FILE"; then
  awk '
    skip { skip = 0; next }
    index($0, "// omarchy-transcribe (managed by") { skip = 1; next }
    { print }
  ' "$MENU_FILE" >"$MENU_FILE.tmp"
  mv -f "$MENU_FILE.tmp" "$MENU_FILE"
  echo "Removed Transcribe from the Omarchy menu"
fi

# Disable or remove? `omarchy plugin remove` deletes the checkout right after
# it disables the plugin; give that a moment, then look.
sleep 1
if [[ -d $PLUGIN_DIR ]]; then
  # A disable: reversible, so the expensive parts stay. The hook copy stays
  # too, as the manual purge path for a plugin removed while disabled.
  "$NOTIFY" -g "$ICON" "Transcribe disabled" "Enable it again from Setup > Plugins. Models kept; remove the plugin to delete everything." -t 8000 || true
  echo "disabled (checkout still present); models and packages kept"
  exit 0
fi

# A remove: purge in a terminal the user can see, since it needs sudo.
echo "removed (checkout gone); purging in a floating terminal"
open_terminal "$STATE_DIR/plugin-disable" --purge
