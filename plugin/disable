#!/bin/bash

# Plugin disable hook. Run by plugin/Service.qml when the shell destroys the
# service, which happens on `omarchy plugin disable`, on `omarchy plugin
# remove`, and when the shell itself restarts. Only the first two are a real
# disable: shell.json still lists the plugin as enabled during a restart, so
# nothing is touched then.
#
# Undoes what plugin/enable did. Downloaded models, config, and state are
# user data and stay; whisper-cpp stays too (it is a regular pacman package).

set -euo pipefail

PLUGIN_ID="mihap.transcribe"
PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="$HOME/.local/bin"
EXT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/nautilus-python/extensions"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-transcribe"
SHELL_JSON="$HOME/.config/omarchy/shell.json"
LOG="$STATE_DIR/plugin.log"

mkdir -p "$STATE_DIR"
exec >>"$LOG" 2>&1
echo "[$(date -Is)] disable: $PLUGIN_DIR"

# On `omarchy plugin remove` the checkout is deleted while this hook is still
# waiting below, so take a copy of the helper now. (bash keeps reading this
# script from its open file descriptor even after the unlink.)
menu_helper=$(mktemp)
trap 'rm -f "$menu_helper"' EXIT
cp -- "$PLUGIN_DIR/bin/omarchy-transcribe-menu" "$menu_helper"

still_enabled() {
  [[ -f $SHELL_JSON ]] && jq -e --arg id "$PLUGIN_ID" \
    '(.plugins // []) | any(.[]; (.id // .) == $id)' "$SHELL_JSON" >/dev/null 2>&1
}

# The shell destroys the service before it has finished writing shell.json,
# so a single look races the write and mistakes a real disable for a restart.
# Give the file a few seconds to change; a restart never changes it.
for (( i = 0; i < 40; i++ )); do
  still_enabled || break
  sleep 0.1
done
if still_enabled; then
  echo "still enabled in shell.json after 4s: shell restart, leaving everything in place"
  exit 0
fi

# Mirror of the enable guard: with the pacman package installed the plugin
# never wired anything, and the menu row belongs to the package.
if pacman -Q omarchy-transcribe &>/dev/null; then
  echo "omarchy-transcribe pacman package is installed; nothing of the plugin's to undo"
  exit 0
fi

# Only remove links that point into this checkout; a pacman-installed copy or
# a hand-made link is not ours.
for f in omarchy-transcribe omarchy-transcribe-install omarchy-transcribe-remove omarchy-transcribe-menu; do
  link="$BIN_DIR/$f"
  [[ -L $link && $(readlink -- "$link") == "$PLUGIN_DIR/"* ]] && rm -f "$link"
done
ext="$EXT_DIR/omarchy-transcribe.py"
[[ -L $ext && $(readlink -- "$ext") == "$PLUGIN_DIR/"* ]] && rm -f "$ext"

bash "$menu_helper" remove

omarchy-notification-send -g 󰨖 "Transcribe disabled" "Command, Files entry and menu row removed. Models kept in ~/.local/share/omarchy-transcribe." -t 8000 || true
echo "disabled"
